# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Node
node_modules/

# Build output
static/js/
*.map

# Secrets — DATABASE_URL and friends belong in Render's dashboard and a
# password manager, never in a file that could end up staged by accident.
.env
.env.*
*.secret

# Newman parallel-load run output
postman/run-logs/

# Real secrets for local stress-test runs — never commit the actual
# session_cookie value; the tracked environment file keeps it blank.
postman/stress-test.local.postman_environment.json
