{
  "name": "task-api-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript + Alpine.js front end for the Task API",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && esbuild src/main.ts --bundle --minify --sourcemap --target=es2020 --format=iife --outfile=../static/js/app.js",
    "dev": "esbuild src/main.ts --bundle --sourcemap --target=es2020 --format=iife --outfile=../static/js/app.js --watch"
  },
  "dependencies": {
    "alpinejs": "^3.14.1"
  },
  "devDependencies": {
    "@types/alpinejs": "^3.13.10",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
