{
  "info": {
    "name": "Task API Stress Test",
    "_postman_id": "b7e3f2b0-6b8a-4e1a-9c2e-task-stress-001",
    "description": "Create a task, rename it, toggle its done/not-done state a random number of times (2-10), then delete it. Run via Collection Runner (set Iterations to however many cycles you want) or via Newman for scripted/parallel load generation.\n\nRequires an authenticated session cookie for the deployed app's Google OAuth login (see postman/README.md).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "task_id", "value": "" },
    { "key": "toggle_count", "value": "" },
    { "key": "toggle_iteration", "value": "" },
    { "key": "current_finished", "value": "false" }
  ],
  "item": [
    {
      "name": "1. Create Task",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Cookie", "value": "session={{session_cookie}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Stress task {{$timestamp}}-{{$randomInt}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/tasks",
          "host": ["{{base_url}}"],
          "path": ["tasks"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Task created (201)\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "const task = pm.response.json();",
              "pm.collectionVariables.set(\"task_id\", task.id);",
              "",
              "// Random number of toggles between 2 and 10 inclusive.",
              "const toggleCount = Math.floor(Math.random() * 9) + 2;",
              "pm.collectionVariables.set(\"toggle_count\", toggleCount);",
              "pm.collectionVariables.set(\"toggle_iteration\", 0);",
              "pm.collectionVariables.set(\"current_finished\", \"false\");",
              "",
              "console.log(`Created task ${task.id}; will toggle ${toggleCount} times`);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. Edit Task Name",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Cookie", "value": "session={{session_cookie}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Edited task {{$timestamp}}-{{$randomInt}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/tasks/{{task_id}}",
          "host": ["{{base_url}}"],
          "path": ["tasks", "{{task_id}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Task renamed (200)\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3. Toggle Task State",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Cookie", "value": "session={{session_cookie}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"finished\": {{current_finished}}\n}"
        },
        "url": {
          "raw": "{{base_url}}/tasks/{{task_id}}",
          "host": ["{{base_url}}"],
          "path": ["tasks", "{{task_id}}"]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const current = pm.collectionVariables.get(\"current_finished\");",
              "const next = current === \"true\" ? \"false\" : \"true\";",
              "pm.collectionVariables.set(\"current_finished\", next);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Task toggled (200)\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const iteration = parseInt(pm.collectionVariables.get(\"toggle_iteration\"), 10) + 1;",
              "pm.collectionVariables.set(\"toggle_iteration\", iteration);",
              "",
              "const target = parseInt(pm.collectionVariables.get(\"toggle_count\"), 10);",
              "",
              "if (iteration < target) {",
              "    pm.execution.setNextRequest(\"3. Toggle Task State\");",
              "} else {",
              "    pm.execution.setNextRequest(\"4. Delete Task\");",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4. Delete Task",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Cookie", "value": "session={{session_cookie}}" }
        ],
        "url": {
          "raw": "{{base_url}}/tasks/{{task_id}}",
          "host": ["{{base_url}}"],
          "path": ["tasks", "{{task_id}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Task deleted (200)\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
